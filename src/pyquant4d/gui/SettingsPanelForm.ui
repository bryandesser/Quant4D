          <font>
           <kerning>true</kerning>
          </font>
         </property>
         <property name="text">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align="center"&gt;&lt;span style=" font-weight:700;"&gt;Syntax Examples&lt;/span&gt;&lt;/p&gt;&lt;p&gt;• Union of B and C, then intersects with A:&lt;br/&gt;&lt;span style=" font-family:'Consolas'; font-weight:700;"&gt;A &amp;amp; (B | C)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;• A squared plus B times C (element-wisely), then transposed: &lt;br/&gt;&lt;span style=" font-family:'Consolas'; font-weight:700;"&gt;(A.^2 + B .* C)'&lt;/span&gt;&lt;/p&gt;&lt;p&gt;• Concatenates (on X-dimension) A's Rows 1-3 to B's Rows 4-to-last: &lt;br/&gt;&lt;span style=" font-family:'Consolas'; font-weight:700;"&gt;[A(1:3,:) ; B(4:end,:)]&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>

# ============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.
# ============================================================

# GitHub repository target
GITHUB_OWNER=bryandesser
GITHUB_REPO=Quant4D

# --- Authentication (use ONE of the two methods below) ------

# RECOMMENDED: Personal Access Token with 'repo' scope.
# The container auto-fetches a fresh registration token on every start,
# so you never need to rotate RUNNER_TOKEN manually.
# Create at: https://github.com/settings/tokens
GITHUB_PAT=

# ALTERNATIVE: One-time registration token (expires ~1 hour after creation).
# Get from: https://github.com/bryandesser/Quant4D/settings/actions/runners/new
# If the container restarts you must replace this token.
RUNNER_TOKEN=

# --- Optional overrides -------------------------------------

# Display name shown in the GitHub runners list (default: container hostname)
# RUNNER_NAME=pyquant4d-gpu-runner-linux

# Extra labels appended to: self-hosted, gpu, Linux, X64
# RUNNER_LABELS=cuda12,torch

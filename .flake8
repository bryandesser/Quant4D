[flake8]
max-line-length = 150

# ---------------------------------------------------------------------------
# Codes suppressed throughout this codebase
#
# The bulk of the pre-existing style issues come from the MATLAB-to-Python
# port.  autopep8 has been run over src/ to fix what it can automatically.
# The codes that remain here are either intentional style choices, physics
# naming conventions, or patterns that require manual review.
#
# Codes that ARE still checked (must not appear):
#   E999  – syntax errors                       (always fatal)
#   W605  – invalid escape sequence in strings  (silent regex bug)
#   F821  – undefined names                     (real NameError at runtime)
# ---------------------------------------------------------------------------
extend-ignore =
    # Import ordering / placement (many deferred imports are intentional)
    E402,
    # Bare except – needs manual review per site
    E722,
    # Ambiguous variable names (l, O, I) – common and intentional in physics code
    E741,
    # Pyflakes: star imports and re-exports (intentional in callback modules)
    F401, F403, F405, F811,
    # Pyflakes: unused variables and format-string issues
    F523, F841,

exclude =
    .git,
    __pycache__,
    src/callbacks/tmp.py,
    src/callbacks/appClassOLD.py,
